---
import { vinotecas, getRowCol } from '../data/vinotecas';
import type { WineWithLocation } from '../types/wine';

interface Props {
  wineWithLocation: WineWithLocation;
}

const { wineWithLocation } = Astro.props;
const { wine, vinoteca, posicion } = wineWithLocation;
const vinotecaData = vinotecas[vinoteca];
const { fila, columna } = getRowCol(posicion, vinotecaData);

const stars = wine.data.puntuacion ? '★'.repeat(Math.round(wine.data.puntuacion)) : '';
---

<article class="bg-white rounded-lg shadow-md hover:shadow-xl transition-shadow p-4 border border-gray-200">
  <div class="flex gap-4">
    <div class="flex-shrink-0">
      <div class="w-24 h-32 bg-wine-100 rounded flex items-center justify-center">
        <span class="text-6xl">🍷</span>
      </div>
    </div>

    <div class="flex-grow">
      <h3 class="text-lg font-bold text-wine-900 mb-1">{wine.data.nombre}</h3>
      <p class="text-sm text-gray-600 mb-2">{wine.data.bodega}</p>

      <div class="space-y-1 text-sm text-gray-700">
        <p><strong>Región:</strong> {wine.data.region}, {wine.data.pais}</p>
        <p><strong>Tipo:</strong> {wine.data.variedad} - {wine.data.tipoUva}</p>
        <p><strong>Precio:</strong> {wine.data.precio.toFixed(2)}€</p>
        {wine.data.puntuacion && (
          <p class="text-yellow-600"><strong>Puntuación:</strong> {stars} ({wine.data.puntuacion}/10)</p>
        )}
      </div>

      <div class="mt-3 pt-3 border-t border-gray-200">
        <p class="text-sm font-semibold text-wine-700">
          {vinotecaData.nombre} - Fila {fila}, Columna {columna}
        </p>
        <p class="text-xs text-gray-500">Posición {posicion}</p>
      </div>
    </div>
  </div>
</article>
